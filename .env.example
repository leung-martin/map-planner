# Copy this file to .env.local and fill it in. See SETUP.md.
# With everything blank the app runs in demo mode: sample places, saved on this device only.

VITE_GOOGLE_MAPS_API_KEY=
# Optional. Create your own Map ID in Google Cloud to replace Google's testing ID.
VITE_GOOGLE_MAPS_MAP_ID=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
